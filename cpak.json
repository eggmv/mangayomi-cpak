{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Mangayomi",
  "description": "Free and open source manga reader and video streaming application.",
  "version": "v0.9.96",
  "image": "ghcr.io/eggmv/mangayomi@a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2",
  "binaries": [
    "/opt/mangayomi/mangayomi"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": true,
    "clipboard": {
      "hostToApp": true,
      "appToHost": true
    },
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": true,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "hostActions": [],
    "filePicker": {
      "openFile": true,
      "openFolder": true,
      "saveFile": true,
      "persistent": true,
      "containingFolder": true
    },
    "filesystem": [
      {
        "path": "home/.local/share/com.kodjodev.mangayomi",
        "access": "read-write"
      },
      {
        "path": "home/Downloads",
        "access": "read-write"
      }
    ],
    "env": [
      "PATH=/opt/mangayomi:/usr/bin:/bin",
      "LD_LIBRARY_PATH=/usr/lib:/usr/lib/x86_64-linux-gnu",
      "GSETTINGS_BACKEND=keyfile"
    ],
    "network": true,
    "process": false,
    "userNamespaces": true,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}