{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Mangayomi",
  "description": "Free and open source manga reader and video streaming application.",
  "version": "latest",
  "image": "ghcr.io/eggmv/mangayomi:latest",
  "binaries": [
    "/opt/mangayomi/mangayomi"
  ],
  "desktop_entries": [
    "/usr/share/applications/Mangayomi.desktop"
  ],
  "form_factors": [
    "desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": true,
    "clipboard": {
      "hostToApp": true,
      "appToHost": true
    },
    "socketWayland": true,
    "socketPulseAudio": true,
    "deviceDri": true,
    "deviceShm": true,
    "deviceVideo": true,
    "notification": true,
    "openURI": true,
    "filePicker": {
      "openFile": true,
      "openFolder": true,
      "saveFile": true,
      "persistent": true,
      "containingFolder": true
    },
    "filesystem": [
      {
        "path": "home/.local/share/com.kodjodev.mangayomi",
        "access": "read-write"
      },
      {
        "path": "home/Downloads",
        "access": "read-write"
      }
    ],
    "env": [
      "PATH=/opt/mangayomi:/usr/bin:/bin",
      "LD_LIBRARY_PATH=/opt/mangayomi/lib:/opt/mangayomi/lib/x86_64-linux-gnu:/usr/lib:/usr/lib/x86_64-linux-gnu",
      "GSETTINGS_BACKEND=keyfile",
      "GTK_A11Y=none"
    ],
    "network": true,
    "userNamespaces": true
  }
}
